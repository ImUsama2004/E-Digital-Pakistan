#!/bin/bash
set -euxo pipefail

dnf install -y docker
systemctl enable --now docker

docker pull ${image}

docker rm -f edp || true
docker run -d \
  --name edp \
  --restart unless-stopped \
  -p 80:3000 \
  --read-only \
  --tmpfs /tmp \
  --tmpfs /app/.next/cache:uid=1001,gid=1001 \
  --cap-drop ALL \
  --security-opt no-new-privileges:true \
  --memory 512m \
  --cpus 1 \
  ${image}
